# Production Environment Configuration
# Copy to .env and fill in your production values
# NEVER commit this file to git

ENV="production"
APP_NAME="AI Recruitment System"
HOST="0.0.0.0"
PORT=8000

# Database: Use PostgreSQL in production
# Format: postgresql://user:password@host:5432/database_name
# Render provides this automatically via DATABASE_URL
DATABASE_URL="postgresql://user:password@db.render.com:5432/recruitment_db"

# Security
JWT_SECRET="generate-a-long-random-string-here"
TEST_TOKEN_EXPIRE_HOURS=48

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.6-flash"

# Gmail SMTP Configuration
GMAIL_USER="hr@your-company.com"
GMAIL_APP_PASSWORD="your-16-char-gmail-app-password"

# n8n Webhook Configuration
N8N_BASE_URL="https://your-n8n-domain.com"
N8N_TEST_RESULT_WEBHOOK_URL="https://your-n8n-domain.com/webhook/test-result"

# Frontend & Backend URLs
FRONTEND_URL="https://your-frontend.vercel.app"
BACKEND_URL="https://your-api.onrender.com"

# Company Information
COMPANY_NAME="Your Company Name"
