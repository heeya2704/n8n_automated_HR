{
  "name": "2 - AI Recruitment Test Result Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "test-result",
        "options": {}
      },
      "id": "node-webhook-test-result",
      "name": "Webhook Test Result",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "test-result-webhook"
    },
    {
      "parameters": {
        "jsCode": "// The FastAPI backend has already scored the test and decided SELECTED / TEST_FAILED\n// using the job-specific passing score. This workflow only delivers the email.\nconst item = $input.item.json.body || $input.item.json;\n\nreturn [{\n  json: {\n    candidate_id: item.candidate_id,\n    candidate_uuid: item.candidate_uuid,\n    candidate_name: item.candidate_name,\n    candidate_email: item.candidate_email,\n    job_title: item.job_title,\n    test_score: item.test_score,\n    passing_score: item.passing_score,\n    is_selected: item.eligible_for_offer === true,\n    email_subject: item.email_subject,\n    email_body: item.email_body,\n    offer_letter_url: item.offer_letter_url,\n    backend_url: item.backend_url || 'http://localhost:8000'\n  }\n}];"
      },
      "id": "node-parse-test-result",
      "name": "Parse Test Result Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_selected }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-if-selected",
      "name": "IF Selected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.offer_letter_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "offer_letter"
            }
          }
        }
      },
      "id": "node-download-offer-letter",
      "name": "Download Offer Letter PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [920, 180]
    },
    {
      "parameters": {
        "sendTo": "={{ $node['Parse Test Result Payload'].json.candidate_email }}",
        "subject": "={{ $node['Parse Test Result Payload'].json.email_subject }}",
        "emailType": "text",
        "message": "={{ $node['Parse Test Result Payload'].json.email_body }}",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "offer_letter"
              }
            ]
          }
        }
      },
      "id": "node-send-offer-email",
      "name": "Send Acceptance Email + Offer Letter (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1160, 180],
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_CREDENTIAL_ID",
          "name": "HR Gmail Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node['Parse Test Result Payload'].json.backend_url }}/api/webhooks/offer-sent",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"candidate_id\": \"{{ $node['Parse Test Result Payload'].json.candidate_uuid }}\",\n  \"candidate_email\": \"{{ $node['Parse Test Result Payload'].json.candidate_email }}\"\n}",
        "options": {}
      },
      "id": "node-confirm-offer-sent",
      "name": "Confirm Offer Sent (FastAPI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1400, 180]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.candidate_email }}",
        "subject": "={{ $json.email_subject }}",
        "emailType": "text",
        "message": "={{ $json.email_body }}",
        "options": {}
      },
      "id": "node-send-test-rejection-email",
      "name": "Send Assessment Rejection Email (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [920, 440],
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_CREDENTIAL_ID",
          "name": "HR Gmail Account"
        }
      }
    }
  ],
  "connections": {
    "Webhook Test Result": {
      "main": [[{ "node": "Parse Test Result Payload", "type": "main", "index": 0 }]]
    },
    "Parse Test Result Payload": {
      "main": [[{ "node": "IF Selected?", "type": "main", "index": 0 }]]
    },
    "IF Selected?": {
      "main": [
        [{ "node": "Download Offer Letter PDF", "type": "main", "index": 0 }],
        [{ "node": "Send Assessment Rejection Email (Gmail)", "type": "main", "index": 0 }]
      ]
    },
    "Download Offer Letter PDF": {
      "main": [[{ "node": "Send Acceptance Email + Offer Letter (Gmail)", "type": "main", "index": 0 }]]
    },
    "Send Acceptance Email + Offer Letter (Gmail)": {
      "main": [[{ "node": "Confirm Offer Sent (FastAPI)", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
